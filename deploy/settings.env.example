# Copy to deploy/settings.env (ignored by git). Non-secret settings only.
# CHAT_RUNTIME, the worker count, CHAT_TRUST_PROXY, the proxy CIDR and every
# private service URL are pinned in compose.prod.yml and cannot be changed here.

# Public frontend configuration, baked into the image at build time.
# Use the same project as SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY in app.env.
# Never put a service-role, SMTP, Redis or model key in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# App budget ledger (USD). Lifetime, never resets by itself. See docs/PRODUCTION_BUDGET.md.
CHAT_SPEND_CAP_USD=REPLACE_WITH_APP_BUDGET_USD
HERMES_RESERVE_USD=0.02
HERMES_TIMEOUT_SECONDS=60

# Per-client limits.
CHAT_REQUESTS_PER_MINUTE=30
CHAT_DAILY_MESSAGES=60

# Gateway: the real dollar guard in front of the provider. Lifetime, never resets by itself.
GATEWAY_CAP_USD=REPLACE_WITH_GATEWAY_BUDGET_USD
GATEWAY_MAX_REQUESTS=REPLACE_WITH_GATEWAY_REQUEST_LIMIT

# Account features. Set PRIVATE_PLANS=off if HTTPS is not in place yet.
PRIVATE_PLANS=on

# Discovery stays off for the first release.
DISCOVERY_ENABLED=false
DISCOVERY_PUBLIC_ENABLED=false
