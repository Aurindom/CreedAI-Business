# /srv/penny/secrets/gateway.env, mode 0600. The only place the OpenRouter key lives.
GATEWAY_PROVIDER_KEY=REPLACE_OPENROUTER_KEY
GATEWAY_CLIENT_KEY=REPLACE_RANDOM_32_PLUS_CHARS
# Comma list of private values the gateway must never forward to the provider.
GATEWAY_FORBIDDEN=REPLACE_HERMES_API_KEY_VALUE,REPLACE_PUBLIC_MCP_TOKEN_VALUE
