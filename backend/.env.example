# Inject these into the backend process through your hosting secrets/environment.
# Backend code does not load .env files automatically.
OPENROUTER_API_KEY=YOUR_TEAM_KEY
CHAT_PROVIDER=openrouter
CHAT_SPEND_CAP_USD=0.10
# Model pinned in app/chat.py; this local ledger is not an account-wide hard cap.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
REDIS_URL=rediss://USER:PASSWORD@HOST:PORT
# For local development with compose.redis.yml only: redis://127.0.0.1:6379/0

# Explicit runtime selection. Hermes/MCP/gateway stay on private service addresses.
CHAT_RUNTIME=openrouter
# To enable the tested Hermes path, select hermes and configure all six endpoints/keys.
HERMES_API_URL=http://hermes:8642
HERMES_API_KEY=REPLACE_WITH_PRIVATE_SERVICE_KEY
HERMES_TIMEOUT_SECONDS=60
PUBLIC_MCP_URL=http://actions:8000/mcp
PUBLIC_MCP_TOKEN=REPLACE_WITH_PRIVATE_MCP_KEY
MODEL_GATEWAY_URL=http://gateway:9999
MODEL_GATEWAY_KEY=REPLACE_WITH_PRIVATE_GATEWAY_KEY

# Discovery is disabled unless explicitly enabled. Never expose an operator token to the UI.
DISCOVERY_ENABLED=false
DISCOVERY_PUBLIC_ENABLED=false
DISCOVERY_SEARCH_PROVIDER=openrouter
# Only this discovery source uses this key; Hermes uses its metered gateway.
DISCOVERY_OPENROUTER_KEY=YOUR_TEAM_KEY
DISCOVERY_AUTO_VERIFY=true
# Shared durable ledger for discovery search and automatic verification calls.
DISCOVERY_MAX_REQUESTS=4
DISCOVERY_SPEND_CAP_USD=1
